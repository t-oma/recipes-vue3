{
    "semi": true,
    "printWidth": 60,
    "tabWidth": 4,
    "useTabs": false,
    "trailingComma": "es5",
    "plugins": ["@ianvs/prettier-plugin-sort-imports"],
    "importOrder": [
        "<BUILTIN_MODULES>",
        "<THIRD_PARTY_MODULES>",
        "^@/",
        "",
        "^[./]",
        "<TYPES>^(node:)",
        "<TYPES>",
        "<TYPES>^@/",
        "<TYPES>^[./]"
    ]
}
